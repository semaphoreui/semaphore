#!/bin/sh
set -e
echoerr() { printf "%s\n" "$*" >&2; }

export FORGE_CONFIG_PATH="${FORGE_CONFIG_PATH:-/etc/forge}"
export FORGE_TMP_PATH="${FORGE_TMP_PATH:-/tmp/forge}"

if test -f "${FORGE_CONFIG_PATH}/requirements.txt"; then
    echoerr "Installing additional python dependencies"
    pip3 install --upgrade \
        -r "${FORGE_CONFIG_PATH}/requirements.txt"
else
    echoerr "No additional python dependencies to install"
fi

echoerr "Starting forge runner"
if test "$#" -ne 1; then
    if [ -n "${FORGE_RUNNER_API_TOKEN:-}" ]; then

      if [ -z "${FORGE_RUNNER_TOKEN:-}" ] && [ -z "${FORGE_RUNNER_TOKEN_FILE:-}" ]; then
        export FORGE_RUNNER_TOKEN_FILE="${FORGE_TMP_PATH}/runner_token.txt"
      fi

      exec /usr/local/bin/forge runner start --no-config --register
    else
      exec /usr/local/bin/forge runner start --no-config
    fi
else
    exec "$@"
fi
